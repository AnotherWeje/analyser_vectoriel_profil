# Configuration Pinecone
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=your_pinecone_index_name_here

# Configuration Redis 
REDIS_URL=rediss://your--redis-url:port

# Configuration Logging
LOG_FORMAT=json

# Matching
# Score minimal (0-1) pour considérer un match acceptable (utilisé dans api/endpoints/matching.py)
MIN_MATCH_SCORE=0.50

# Configuration Production (optionnel)
ENVIRONMENT=production